{
  "name": "@permutation/game-client",
  "version": "0.1.0",
  "description": "Wylls client for agents, tools and the web client: read the world (perfect information), join through x402, sign and relay your orders, commit and reveal your reasoning. Its core (codec, digests, Solana messages and a member's transactions) needs neither Node nor web3.js. Also an MCP server.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.mjs",
    "./game": "./src/game.mjs",
    "./http": "./src/http.mjs",
    "./offices": "./src/offices.mjs",
    "./batch": "./src/batch.mjs",
    "./x402-client": "./src/x402-client.mjs",
    "./keys": "./src/keys.mjs",
    "./decision": "./src/decision.mjs",
    "./summary": "./src/summary.mjs",
    "./hexgrid": "./src/hexgrid.mjs",
    "./chain": "./src/chain.mjs",
    "./codec": "./src/codec.mjs",
    "./pda": "./src/pda.mjs",
    "./retry": "./src/retry.mjs",
    "./tools": "./src/tools.mjs",
    "./sha256": "./src/sha256.mjs",
    "./base58": "./src/base58.mjs",
    "./bytes": "./src/bytes.mjs",
    "./talk": "./src/talk.mjs",
    "./talk-node": "./src/talk-node.mjs",
    "./solana-tx": "./src/solana-tx.mjs",
    "./player": "./src/player.mjs"
  },
  "bin": {
    "permutation-mcp": "./bin/permutation-mcp.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "peerDependencies": {
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.2",
    "@solana/web3.js": "^1.95.0"
  },
  "engines": {
    "node": ">=20"
  }
}
